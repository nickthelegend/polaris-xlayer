{
  "name": "@polaris/keeper-solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Polaris crank. Reads what is due on chain, simulates it, lands it, and decides what to do when a charge fails.",
  "bin": { "polaris-keeper": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "collect": "node --experimental-strip-types src/cli.ts collect",
    "subscriptions": "node --experimental-strip-types src/cli.ts subscriptions",
    "liquidate": "node --experimental-strip-types src/cli.ts liquidate",
    "start": "node --experimental-strip-types src/cli.ts all"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
