# Anchor / Solana
.anchor
# Everything under target/ is a build artifact, the program keypair included.
#
# There used to be a `!target/deploy/*-keypair.json` negation here, which does
# nothing at all: git cannot re-include a file inside an excluded directory, so
# the keypair was never committed and `anchor build` on a fresh clone mints a
# new, random one. `anchor keys sync` is the documented way out — see the
# README's quick start — and publishing a program's identity key would be the
# wrong fix.
target/
test-ledger/
.program-id.txt

# merchant-web and shopping are not pnpm workspace members; they install standalone.
merchant-web/node_modules/
shopping/node_modules/
