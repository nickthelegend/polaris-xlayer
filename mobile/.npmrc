# Expo needs a hoisted node_modules, and this app is installed standalone.
#
# `mobile` is deliberately not a member of the pnpm workspace next door (see
# ../pnpm-workspace.yaml), so it carries its own lockfile and this file governs
# only this app — the thirteen packages beside it keep pnpm's isolated linker.
#
# Expo's own packages declare `react` and `react-native` as peer dependencies
# and reach each other through @expo/cli. Under the isolated linker those peers
# are not beside the real package directory, and Metro — which resolves through
# the symlink target — fails with "react could not be found within the project
# or in these directories: node_modules, ../node_modules". LogBox then dies
# mid-render and the console fills with "Invalid hook call ... more than one
# copy of React". Hoisting is what the Expo documentation asks for with pnpm.
node-linker=hoisted
